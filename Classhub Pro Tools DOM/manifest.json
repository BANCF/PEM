{
  "manifest_version": 3,
  "name": "ClassHub Pro Tools ",
  "version": "3.3.1",
  "description": "Bộ công cụ tự động Nhập Điểm và Điểm Danh siêu tốc cho ClassHub.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://idcloud.vn/*",
    "*://*.idcloud.vn/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  }
}