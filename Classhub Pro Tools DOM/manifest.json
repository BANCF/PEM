{
  "manifest_version": 3,
  "name": "ClassHub Pro Tools TEST",
  "version": "3.6.6",
  "description": "Bộ công cụ tự động Nhập Điểm và Điểm Danh siêu tốc cho ClassHub.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.idcloud.vn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["ajax_spy.js"],
      "matches": ["*://*.idcloud.vn/*"]
    }
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  }
}