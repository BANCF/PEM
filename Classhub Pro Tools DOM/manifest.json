{
  "manifest_version": 3,
  "name": "ClassHub Pro Tool TEST",
  "version": "3.7.1",
  "description": "Bộ công cụ tự động Nhập Điểm và Điểm Danh siêu tốc cho ClassHub.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.idcloud.vn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ajax_spy.js"
      ],
      "matches": [
        "*://*.idcloud.vn/*"
      ]
    }
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  }
}