{
  "manifest_version": 3,
  "name": "ClassHub Pro Tool",
  "version": "3.7.2",
  "description": "Bộ công cụ tự động Nhập Điểm và Điểm Danh siêu tốc cho ClassHub.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://idcloud.vn/*",
        "*://*.idcloud.vn/*",
        "*://*.vnpt.vn/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "api_scanner.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "*://*.idcloud.vn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [],
      "matches": [
        "*://*.idcloud.vn/*"
      ]
    }
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  }
}