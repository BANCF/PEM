{
  "manifest_version": 3,
  "name": "ClassHub Pro Tools",
  "version": "3.6.2",
  "description": "Bộ công cụ tự động Nhập Điểm và Điểm Danh siêu tốc cho ClassHub.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.idcloud.vn/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  }
}